SECRET_KEY=your-secret-key-here
DB_NAME=esm
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── Firebase Configuration (pour boutique en ligne) ───────────────
# Chemin vers le fichier de credentials du service account Firebase
# Format: /chemin/vers/service-account.json
FIREBASE_CREDENTIALS=

# Nom du bucket Firebase Storage (pour les images)
# Format: projet-id.appspot.com
FIREBASE_STORAGE_BUCKET=

# ID du projet Firebase
FIREBASE_PROJECT_ID=

# Production uniquement
# ALLOWED_HOSTS=mondomaine.com,www.mondomaine.com
