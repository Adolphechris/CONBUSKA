{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@nuxtjs/vercel-builder",
      "config": {
        "framework": "nuxt"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-frame-options",
          "value": "DENY"
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "x-xss-protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "outputDirectory": ".output/public",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  }
}
